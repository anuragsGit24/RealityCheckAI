# ============================================================
# .env.example — Copy to .env and fill in your values
# ============================================================

# ── LLM Provider ──────────────────────────────────────────
# Options: "openai" | "groq" | "ollama"
# "groq" is recommended for free, fast inference — no GPU required
LLM_PROVIDER=groq

# ── OpenAI (used when LLM_PROVIDER=openai) ────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Groq (used when LLM_PROVIDER=groq) ────────────────────
# Free API key: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Recommended models (fast, free tier):
#   llama-3.1-8b-instant     ← default (fastest)
#   llama-3.3-70b-versatile  ← best quality
#   mixtral-8x7b-32768       ← long-context
#   gemma2-9b-it             ← lightweight
GROQ_MODEL=llama-3.1-8b-instant
# Embeddings for Groq are computed locally (no API key needed):
GROQ_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Ollama (used when LLM_PROVIDER=ollama) ────────────────
# Requires: ollama serve  +  ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── Qdrant ────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=roast_resume

# ── Ingestion ─────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── FastAPI ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
